{
  "name": "tandem-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "cargo build --locked --manifest-path ../relay/Cargo.toml && pnpm build && tsx test/browser.e2e.ts",
    "test:container": "tsx test/container.e2e.ts",
    "test:hosting": "tsx test/hosting.e2e.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "highlight.js": "^11.12.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.69.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
