{
  "name": "tandem-relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "cargo build --locked && tsx --test test/*.test.ts",
    "dev": "cargo run --locked",
    "start": "./target/release/tandem-relay",
    "build": "cargo build --locked --release",
    "fake-host": "tsx dev/fake-host.ts",
    "interop": "cargo build --locked && tsx dev/real-desktop.mts"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "ws": "^8.18.3"
  }
}
